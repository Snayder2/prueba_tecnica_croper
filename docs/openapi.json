      "get": {
        "description": "Lista paginada. `search` busca en el nombre sin distinguir mayúsculas ni tildes. Si `page` supera `totalPages`, devuelve `data: []` con el `meta` correcto.",
        "operationId": "ProductsController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Número de página (empieza en 1)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "example": 1,
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Elementos por página",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10,
              "type": "integer"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Texto a buscar en el nombre (sin distinguir mayúsculas ni tildes)",
            "schema": {
              "maxLength": 100,
              "example": "cafe",
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Campo de ordenamiento",
            "schema": {
              "default": "createdAt",
              "example": "price",
              "type": "string",
              "enum": [
                "name",
                "price",
                "stock",
                "createdAt"
              ]
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Dirección del ordenamiento",
            "schema": {
              "default": "desc",
              "example": "asc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de productos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedProductsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de consulta inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "limit fuera de rango",
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": [
                        "limit must not be greater than 100"
                      ],
                      "path": "/api/v1/products",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  },
                  "case2": {
                    "summary": "sortBy no permitido",
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": [
                        "sortBy must be one of the following values: name, price, stock, createdAt"
                      ],
                      "path": "/api/v1/products",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin token, token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "No autenticado",
                    "value": {
                      "statusCode": 401,
                      "error": "Unauthorized",
                      "message": "Unauthorized",
                      "path": "/api/v1/products",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite global de peticiones superado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Demasiadas peticiones",
                    "value": {
                      "statusCode": 429,
                      "error": "Too Many Requests",
                      "message": "Too many requests",
                      "path": "/api/v1/products",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar productos",
        "tags": [
          "Products"
        ]
      }
    },
