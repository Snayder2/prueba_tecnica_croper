{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "description": "Registro abierto. La respuesta nunca incluye la contraseña.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Datos inválidos",
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": [
                        "email must be an email",
                        "password must contain at least one letter and one number"
                      ],
                      "path": "/api/v1/auth/register",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "El email ya está registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Email duplicado",
                    "value": {
                      "statusCode": 409,
                      "error": "Conflict",
                      "message": "Email already registered",
                      "path": "/api/v1/auth/register",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite global de peticiones superado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Demasiadas peticiones",
                    "value": {
                      "statusCode": 429,
                      "error": "Too Many Requests",
                      "message": "Too many requests",
                      "path": "/api/v1/auth/register",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Registrar un usuario",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Devuelve el JWT. Cópialo en **Authorize** para probar los endpoints protegidos. Límite: 5 intentos por minuto por IP.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credenciales válidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Datos inválidos",
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": [
                        "email must be an email"
                      ],
                      "path": "/api/v1/auth/login",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Email o contraseña incorrectos (mensaje genérico)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Credenciales incorrectas",
                    "value": {
                      "statusCode": 401,
                      "error": "Unauthorized",
                      "message": "Invalid credentials",
                      "path": "/api/v1/auth/login",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Más de 5 intentos por minuto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                },
                "examples": {
                  "case1": {
                    "summary": "Demasiadas peticiones",
                    "value": {
                      "statusCode": 429,
                      "error": "Too Many Requests",
                      "message": "Too many requests",
                      "path": "/api/v1/auth/login",
                      "timestamp": "2026-11-17T21:30:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Iniciar sesión",
        "tags": [
          "Auth"
        ]
      }
    },
