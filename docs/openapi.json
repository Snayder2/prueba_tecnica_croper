  "info": {
    "title": "API de Productos",
    "description": "API REST para gestionar productos (NestJS + MongoDB).\n\n**Cómo probarla desde aquí**\n1. `POST /auth/register`: crea un usuario.\n2. `POST /auth/login`: copia el `accessToken` de la respuesta.\n3. Pulsa **Authorize**, pega el token y prueba los endpoints de `Products`.\n\nTodos los errores usan el mismo formato (`ErrorResponseDto`).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Registro, inicio de sesión y usuario actual"
    },
    {
      "name": "Products",
      "description": "CRUD de productos (requiere JWT)"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Token obtenido en POST /auth/login"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email (se guarda en minúsculas)",
            "example": "ana@correo.com"
          },
          "password": {
            "type": "string",
            "description": "Mínimo 8 caracteres, con al menos una letra y un número",
            "format": "password",
            "minLength": 8,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).+$",
            "example": "Clave1234"
          },
          "name": {
            "type": "string",
            "description": "Nombre del usuario",
            "minLength": 2,
            "maxLength": 60,
            "example": "Ana Pérez"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "ObjectId del usuario",
            "example": "6739f2a1c4e5b8a9d0f12345"
          },
          "email": {
            "type": "string",
            "example": "ana@correo.com"
          },
          "name": {
            "type": "string",
            "example": "Ana Pérez"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-17T21:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-17T21:30:00.000Z"
          }
        },
        "required": [
          "_id",
          "email",
          "name",
          "createdAt",
          "updatedAt"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "Código HTTP",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Nombre del código HTTP",
            "example": "Bad Request"
          },
          "message": {
            "description": "Arreglo de mensajes en errores de validación (cada uno empieza con el nombre del campo); texto en los demás errores",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": [
              "price must not be less than 0"
            ]
          },
          "path": {
            "type": "string",
            "description": "Ruta de la petición",
            "example": "/api/v1/products"
          },
          "timestamp": {
            "type": "string",
            "description": "Fecha del error (ISO 8601, UTC)",
            "format": "date-time",
            "example": "2026-11-17T21:30:00.000Z"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "path",
          "timestamp"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@correo.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Clave1234"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT para el header Authorization",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "description": "Vigencia del token en segundos",
            "example": 3600
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del producto (sin espacios al inicio ni al final)",
            "minLength": 3,
            "maxLength": 100,
            "example": "Fertilizante NPK 15-15-15 50 kg"
          },
          "description": {
            "type": "string",
            "description": "Descripción del producto",
            "maxLength": 500,
            "example": "Fertilizante compuesto para cultivos de ciclo corto"
          },
          "price": {
            "type": "number",
            "description": "Precio. Mayor o igual a 0, con máximo 2 decimales",
            "minimum": 0,
            "example": 145000
          },
          "stock": {
            "type": "integer",
            "description": "Unidades disponibles (entero mayor o igual a 0)",
            "minimum": 0,
            "example": 40
          },
          "category": {
            "type": "string",
            "description": "Categoría del producto",
            "maxLength": 50,
            "example": "Fertilizantes"
          },
          "sku": {
            "type": "string",
            "description": "Código único: letras mayúsculas, números y guiones",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[A-Z0-9-]+$",
            "example": "FER-NPK-50"
          },
          "isActive": {
            "type": "boolean",
            "description": "Si el producto está activo",
            "default": true,
            "example": true
          }
        },
        "required": [
          "name",
          "price",
          "stock",
          "sku"
        ]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "ObjectId del producto",
            "example": "6739f3b2c4e5b8a9d0f12346"
          },
          "name": {
            "type": "string",
            "example": "Café de origen Huila 500 g"
          },
          "description": {
            "type": "string",
            "example": "Café especial tostado medio"
          },
          "price": {
            "type": "number",
            "example": 32000
          },
          "stock": {
            "type": "integer",
            "example": 120
          },
          "category": {
            "type": "string",
            "example": "Café"
          },
          "sku": {
            "type": "string",
            "example": "CAF-HUI-500"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-17T21:35:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-17T21:35:00.000Z"
          }
        },
        "required": [
          "_id",
          "name",
          "price",
          "stock",
          "sku",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "description": "Página actual",
            "example": 1
          },
          "limit": {
            "type": "number",
            "description": "Elementos por página",
            "example": 10
          },
          "total": {
            "type": "number",
            "description": "Total de elementos que cumplen el filtro",
            "example": 42
          },
          "totalPages": {
            "type": "number",
            "description": "Total de páginas",
            "example": 5
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "PaginatedProductsResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre del producto (sin espacios al inicio ni al final)",
            "minLength": 3,
            "maxLength": 100,
            "example": "Fertilizante NPK 15-15-15 50 kg"
          },
          "description": {
            "type": "string",
            "description": "Descripción del producto",
            "maxLength": 500,
            "example": "Fertilizante compuesto para cultivos de ciclo corto"
          },
          "price": {
            "type": "number",
            "description": "Precio. Mayor o igual a 0, con máximo 2 decimales",
            "minimum": 0,
            "example": 145000
          },
          "stock": {
            "type": "integer",
            "description": "Unidades disponibles (entero mayor o igual a 0)",
            "minimum": 0,
            "example": 40
          },
          "category": {
            "type": "string",
            "description": "Categoría del producto",
            "maxLength": 50,
            "example": "Fertilizantes"
          },
          "sku": {
            "type": "string",
            "description": "Código único: letras mayúsculas, números y guiones",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[A-Z0-9-]+$",
            "example": "FER-NPK-50"
          },
          "isActive": {
            "type": "boolean",
            "description": "Si el producto está activo",
            "default": true,
            "example": true
          }
        }
      }
    }
  }
}
